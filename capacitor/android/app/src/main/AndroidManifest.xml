<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            The thing that rings for an instance that cannot wake this phone.

            `exported="false"` because nothing outside this app has any business
            starting it: the alarms are set by the app itself, and the boot
            broadcast reaches a receiver that is not exported. See Ringer.java
            for why a web page cannot do this job.
        -->
        <receiver
            android:name=".RingerReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        What the Ringer needs, declared by the app that ships it. Both also
        arrive through @capacitor/local-notifications' manifest merge, but the
        RingerReceiver is this app's own code: dropping that plugin one day
        must not silently stop alarms surviving a reboot or notifications
        being shown at all.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Recordings.

        Without this the web view's `getUserMedia` cannot succeed and Android
        never asks: the app does not hold the permission, so there is nothing
        for it to prompt about. What that looked like was a Record button that
        answered "this device would not give the app a microphone" on a device
        with a perfectly good microphone, and no way for anybody to fix it.

        Declared and nothing more: Capacitor's web view client asks the person
        the first time a page reaches for a microphone, which is the right
        moment — when they have just pressed Record, rather than at install.
    -->
    <!--
        Alarms that go off when they say they will.

        Without these, `setExactAndAllowWhileIdle` throws on Android 12 and up
        and the code falls back to an inexact alarm — which Doze defers, in
        practice by minutes and sometimes by a quarter of an hour. Every
        reminder this app has ever set on a modern phone has been late by
        design, and the reason written in `Ringer.java` was that asking for the
        permission is "a promise about what the app is for".

        It is, and the promise is true: this app sets alarms a person asked for,
        at times they chose, and a reminder told twenty minutes after the fact
        is not a reminder. USE_EXACT_ALARM is the permission Android added for
        exactly this kind of app — alarm clocks and calendars — and it is
        granted at install with no prompt. SCHEDULE_EXACT_ALARM covers Android
        12, where the newer one does not exist; there it is a permission the
        person can revoke, which is why the inexact fallback stays.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!--
        And this one, which is the reason saying yes was not enough.

        Capacitor's web view client asks for RECORD_AUDIO *and*
        MODIFY_AUDIO_SETTINGS together, and grants the page only if every one
        of them comes back granted. MODIFY_AUDIO_SETTINGS is a normal
        permission — Android grants it at install and never asks — but only to
        an app that declares it. Undeclared, it came back denied, so the pair
        failed however firmly somebody had just said yes to the microphone.

        Which is exactly what it looked like: the Android dialog appeared, "Only
        this time" was chosen, and the app still said the device would not give
        it a microphone.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
</manifest>
