# What a running instance needs. Copy to `.env` and fill in the two that matter.
#
# For Docker (`docker compose up -d`) only ORIGIN and BETTER_AUTH_SECRET are
# read from here — the image sets the paths and the port itself.

# The address people type, exactly as it appears in the browser's bar.
#
# The app checks every form submission against this. That check is the whole of
# its CSRF defence, so an ORIGIN that disagrees with the address bar means every
# form is refused and nothing says why.
ORIGIN="http://localhost:1493"

# Sessions are signed with this. Generate one and keep it — changing it signs
# everybody out:
#
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""

# The port on the host. The container always listens on 1493 inside.
# PORT=1493

# ── Running it without Docker ────────────────────────────────────────────────
#
# Where the SQLite file goes. Left unset, the app uses
# ~/.local/share/ontoplano/ontoplano.db.
# DATABASE_URL=local.db
