# @sqlite.org/sqlite-wasm declares "node >= 22", but this app only ever runs
# it in the browser — the worker of the isolated instance — so the
# engines claim describes a use this repository does not make. Without this
# line, yarn refuses to install anything on the node 20 LTS still on real
# machines, which is a hard stop over a constraint that does not apply.
--install.ignore-engines true
