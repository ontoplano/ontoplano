# Every tunable default of this repo's tooling, in one file — the place to
# look when a value is not set anywhere else. The Makefile includes it and
# scripts may source it; static KEY=value only, so make, a shell and systemd
# all read the same thing. A deployment overrides these in local.mk (which
# loads after) or on the command line — never by editing this file.

# The port the app serves, dev and production alike.
APP_PORT=1493

# Where `make android-share` serves the built APK on the LAN.
APK_PORT=8088

# The Android signing key and identity. The package name is permanent once
# published; the alias and keystore path only change if the key does.
ANDROID_KEYSTORE=android-twa/android.keystore
ANDROID_KEY_ALIAS=ontoplano
ANDROID_PACKAGE_NAME=app.ontoplano.twa
