[Unit]
Description=Ontoplano - Weekly Routine Dashboard
After=network.target
# In [Unit], not [Service]: systemd moved these in v229 and ignores them
# quietly in the old place. Without it, five restarts in ten seconds and the
# unit gives up for good — which is how a box is dead at 3am with a clean log.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=${HOME}/.local/share/ontoplano/app
# Substituted by `make install-service` with the node that built node_modules.
#
# It used to say /usr/bin/node, which is a different binary from the one on a
# developer's PATH the moment nvm or NodeSource is involved — and better-sqlite3
# is compiled against one ABI. The result is a unit that crash-loops with
# ERR_DLOPEN_FAILED while `node build/index.js` by hand works perfectly.
ExecStart=${NODE_BIN} build/index.js
# Always, not on-failure: a clean exit nobody asked for is still the app being
# down, and that is the one this has to survive.
Restart=always
RestartSec=2
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=1493
EnvironmentFile=%h/.config/ontoplano/env

[Install]
WantedBy=default.target
