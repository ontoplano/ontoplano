#!/bin/sh
#
# The last look before it leaves: the files in this push.
#
# A red pipeline is found minutes later, by somebody who has moved on to the
# next thing, and the commit that broke it is already on the branch.
#
# **Formatting is fixed here, not reported.** Prettier has one answer per file
# and can write it, so this writes it. A push carries the commits it started
# with and cannot be made to carry a new one, so the fix becomes a commit of
# its own and the push stops with one line saying to push again. The ordinary
# case never reaches this: `pre-commit` formats what is committed, so by the
# time anything is pushed there is nothing left to fix. This is for commits
# made before the hooks existed, or with `--no-verify`.
#
# **Only the files in the push.** `yarn lint` reads the whole repository, which
# is a minute — and a hook that costs a minute on every push is a hook that
# teaches people to type `--no-verify`, after which it is checking nothing at
# all. Prettier and ESLint over a handful of changed files are a second or two.
#
# NOT the tests. The unit suite is a minute and the browser suite is several,
# and the usual shape is to run the suites, get a green, and push what was
# green — paying for them again at the push is paying twice.
#
#   PREPUSH_TESTS=1 git push     run the unit suite here too
#   PREPUSH_ALL=1 git push       lint the whole repo, as CI does
#   git push --no-verify         skip this entirely
#
# Installed by `make hooks`, which `make dev` runs — see the Makefile.
set -e

remote_sha=""
local_sha=""

# git hands pre-push the refs on stdin: <local ref> <local sha> <remote ref>
# <remote sha>. The remote sha is what the other end already has, so the range
# between them is exactly what this push adds.
while read -r _local_ref this_local _remote_ref this_remote; do
	[ -n "$this_local" ] || continue
	case "$this_local" in *[!0]*) ;; *) continue ;; esac
	local_sha="$this_local"
	remote_sha="$this_remote"
done

changed() {
	# A branch the remote has never seen reports all zeros; compare against the
	# default branch instead, or the push would lint the repository's history.
	case "$remote_sha" in
		'' | *[!0]*) base="$remote_sha" ;;
		*) base="$(git merge-base HEAD origin/master 2>/dev/null || true)" ;;
	esac
	[ -n "$base" ] || base="$(git rev-parse HEAD~1 2>/dev/null || true)"
	[ -n "$base" ] || return 0
	git diff --name-only --diff-filter=ACMR "$base" "${local_sha:-HEAD}" --
}

if [ "$PREPUSH_ALL" = 1 ]; then
	echo "pre-push: linting everything, as CI does"
	yarn -s lint
else
	files=$(changed | grep -E '\.(ts|js|mjs|cjs|svelte|css|json|md|html|svx)$' || true)
	# Deleted in a later commit of the same push: the name is in the range and
	# the file is not on disk, and prettier treats a missing path as an error.
	present=""
	for file in $files; do
		[ -f "$file" ] && present="$present $file"
	done

	if [ -z "$present" ]; then
		echo "pre-push: nothing to lint in this push"
	else
		count=$(printf '%s\n' $present | wc -l | tr -d ' ')
		echo "pre-push: checking $count file(s) in this push (PREPUSH_ALL=1 for everything)"

		if ! yarn -s prettier --check --log-level warn $present >/dev/null 2>&1; then
			# What the tree already had uncommitted, so this can tell its own
			# work from yours and never commit yours by accident.
			yours=$(git status --porcelain -- $present | wc -l | tr -d ' ')
			yarn -s prettier --write --log-level warn $present >/dev/null
			mine=$(git status --porcelain -- $present | wc -l | tr -d ' ')

			if [ "$yours" -gt 0 ]; then
				echo "pre-push: formatting was wrong. It is written to disk — but these files"
				echo "  also have uncommitted work in them, so committing it is yours to do."
				exit 1
			fi

			if [ "$mine" -gt 0 ]; then
				# shellcheck disable=SC2086
				git add $present
				git commit -q -m "style: prettier"
				echo "pre-push: formatting was wrong; fixed and committed as \"style: prettier\"."
				echo "  A push carries the commits it started with — so: git push again."
				exit 1
			fi
		fi

		yarn -s eslint $present
	fi
fi

if [ "$PREPUSH_TESTS" = 1 ]; then
	echo "pre-push: the unit suite too, as asked"
	yarn -s test:unit
fi
