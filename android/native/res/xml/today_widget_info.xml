<?xml version="1.0" encoding="utf-8"?>
<!--
    Half an hour is the shortest period the launcher honours for a widget it
    wakes itself; anything more often has to be a job, and a planner that is
    thirty minutes stale is not wrong in a way anybody notices. The refresh
    button covers the case where it is.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_today"
    android:previewLayout="@layout/widget_today"
    android:configure="__PACKAGE__.WidgetConfigureActivity"
    android:description="@string/widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
