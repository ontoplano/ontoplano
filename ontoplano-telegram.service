[Unit]
Description=Ontoplano Telegram Bot
After=network.target

[Service]
Type=simple
WorkingDirectory=${HOME}/codes/ontoplano/telegram
ExecStart=/usr/bin/node --import=tsx src/index.ts
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
EnvironmentFile=%h/.config/ontoplano/env

[Install]
WantedBy=default.target
