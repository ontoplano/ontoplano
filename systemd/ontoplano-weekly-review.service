[Unit]
Description=Ontoplano — Monday's weekly review mail, for whoever's Monday it is

[Service]
Type=oneshot
# The env file the app already reads: the health token this asks with, and
# PORT if it is not the default.
EnvironmentFile=%h/.config/ontoplano/env
# A request to the running app; the app itself remembers which week it last
# wrote about per account, so an extra ask costs one cheap read.
ExecStart=${NODE_BIN} -e "const job='weekly-reviews';const port=process.env.PORT||1493;fetch('http://127.0.0.1:'+port+'/api/jobs/'+job,{method:'POST',headers:{'x-health-token':process.env.ONTOPLANO_HEALTH_TOKEN||''}}).then(function(res){if(!res.ok){console.error('jobs/'+job+' answered '+res.status);process.exit(1);}}).catch(function(error){console.error(String(error));process.exit(1);})"
