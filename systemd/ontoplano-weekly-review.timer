[Unit]
Description=Ontoplano — the weekly review mail, checked every hour

[Timer]
# Hourly, because the hour belongs to the account. Seven in the morning is a
# different instant for everybody, and a job that ran once a day could only
# ever be right for one timezone. Twenty-three of these runs do nothing.
OnCalendar=*-*-* *:05:00
# A machine that was off at somebody's seven still writes when it comes back —
# the pending review does not expire, so a late mail is a mail, not a wrong one.
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
