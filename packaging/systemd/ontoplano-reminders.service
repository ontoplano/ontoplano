[Unit]
Description=Ontoplano — due reminders, asked of the running app

[Service]
Type=oneshot
User=ontoplano
Group=ontoplano
# What the app reads, and what holds the health token this asks with.
EnvironmentFile=/etc/ontoplano/ontoplano.env
EnvironmentFile=/etc/ontoplano/secret.env
ExecStart=/usr/lib/ontoplano/jobs reminders
