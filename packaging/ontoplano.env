# Ontoplano, as installed from a package.
#
# Everything an operator sets. The paths, the port and the runtime are the
# unit's business (`systemctl cat ontoplano`); this file is the two settings
# that matter and the ones that are worth having.
#
# After editing:  sudo systemctl restart ontoplano

# ── The one you must set ────────────────────────────────────────────────────
#
# The address people type, exactly as it appears in the browser's bar —
# scheme and all, no trailing slash. Every form submission is checked against
# it, which is the whole of the CSRF defence, so an ORIGIN that disagrees with
# the address bar means every form is refused and nothing says why.
ORIGIN="http://localhost:1493"

# ── The one the package sets for you ────────────────────────────────────────
#
# Sessions are signed with a secret, generated on install and kept in
# /etc/ontoplano/secret.env — a separate file so that upgrading the package
# never touches it and never asks you about it. Changing it signs everybody
# out. Back it up with the database.

# ── Where it listens ────────────────────────────────────────────────────────
#
# 127.0.0.1 by default: a fresh install is not on the internet until you put
# something in front of it. Put a reverse proxy on the machine and give it TLS
# — or, if this is a private network and you know what you are doing,
# HOST=0.0.0.0.
# HOST=127.0.0.1
# PORT=1493

# ── Mail, if you want it ────────────────────────────────────────────────────
#
# Without an account here, confirmation and password-reset links are written
# to the journal instead of sent — which is fine for one person, and is why
# this is optional. `journalctl -u ontoplano | grep -i verify` finds them.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM="Ontoplano <plano@example.com>"
# SMTP_USER=
# SMTP_PASS=

# ── Who may sign up ─────────────────────────────────────────────────────────
#
# open        anybody with the address
# invite      only somebody holding an invitation you made
# closed      nobody; the accounts that exist are the accounts there are
#
# The first account is always allowed whatever this says, and owns the
# instance.
# ONTOPLANO_REGISTRATION=open

# ── The rest ────────────────────────────────────────────────────────────────
#
# Every other setting, what it does and what it defaults to:
# https://docs.ontoplano.com/configuration.html
